# Copy this file to .env and fill in your institution's Brightspace URL.
BRIGHTSPACE_BASE_URL=https://brightspace.tudelft.nl

# Optional - only needed for scripts/scripted_login.py (fully automated
# login, no display/human needed). Leave blank to only use
# scripts/bootstrap_login.py (interactive).
BRIGHTSPACE_USERNAME=
BRIGHTSPACE_PASSWORD=

# Optional - a shell command that prints a one-time verification code to
# stdout, used as a fallback if scripted_login.py hits a step-up
# challenge it can otherwise recognize (a code-entry field appears).
# Leave unset to just fail loudly in that case instead. See
# browser_session.py's _find_email_code docstring.
EMAIL_CODE_CHECK_COMMAND=
