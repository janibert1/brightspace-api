# Copy this file to .env (in whatever directory you run brightspace-api
# from) and fill in your institution's Brightspace URL. Real environment
# variables always override this file - set BRIGHTSPACE_ENV_FILE to point
# at a specific .env path instead of the default (cwd).
BRIGHTSPACE_BASE_URL=https://brightspace.tudelft.nl

# Optional - only needed for the fully automated login
# (brightspace-login-scripted / bootstrap_login_scripted()). Leave blank
# to only use the interactive login.
BRIGHTSPACE_USERNAME=
BRIGHTSPACE_PASSWORD=

# Optional - a shell command that prints a one-time verification code to
# stdout, used as a fallback if the scripted login hits a step-up
# challenge it can otherwise recognize (a code-entry field appears).
# Leave unset to just fail loudly in that case instead. See
# brightspace_api/session.py's _find_email_code docstring.
EMAIL_CODE_CHECK_COMMAND=

# Optional - where the saved session/downloads live. Defaults to
# ~/.brightspace-api/ if unset. Override to point multiple installs at
# the same already-logged-in session.
BRIGHTSPACE_STORAGE_STATE_FILE=
BRIGHTSPACE_DOWNLOADS_DIR=
